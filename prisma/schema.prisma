generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ReadyHome {
  id        String   @id @default(cuid())
  title     String
  price     String
  area      String
  land      String
  rooms     String
  baths     String
  location  String
  status    String
  image     String
  image2    String?
  image3    String?
  image4    String?
  sortOrder Int      @default(0)
  isVisible Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Project {
  id          String   @id @default(cuid())
  name        String
  area        String
  floors      String
  price       String
  time        String
  tag         String
  description String
  image       String
  image2      String?
  image3      String?
  plan        String?
  sortOrder   Int      @default(0)
  isVisible   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model BuildingHome {
  id        String   @id @default(cuid())
  title     String
  stage     String
  finish    String
  location  String
  image     String   @default("")
  image2    String?
  image3    String?
  image4    String?
  sortOrder Int      @default(0)
  isVisible Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Plot {
  id        String   @id @default(cuid())
  title     String
  area      String
  utilities String
  location  String
  image     String   @default("")
  image2    String?
  image3    String?
  image4    String?
  sortOrder Int      @default(0)
  isVisible Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PriceRow {
  id        String   @id @default(cuid())
  work      String
  warm      String
  pre       String
  full      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FaqItem {
  id        String   @id @default(cuid())
  question  String
  answer    String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SiteSetting {
  key   String @id
  value String
}

model BuiltObject {
  id        String   @id @default(cuid())
  title     String
  area      String
  location  String
  year      String
  image     String
  image2    String?
  image3    String?
  image4    String?
  sortOrder Int      @default(0)
  isVisible Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Отзывы покупателей — скриншоты (переписки/отзывы с площадок) в горизонтальной
// ленте. Каждая запись = один скрин + необязательная подпись. В будущем сюда же
// планируются видеоотзывы (добавится отдельное поле/модель).
model Review {
  id        String   @id @default(cuid())
  image     String
  caption   String?
  sortOrder Int      @default(0)
  isVisible Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Заявки с сайта (лид-формы + квиз). Пишутся в БД ПЕРВЫМИ (гарантия сохранности),
// затем уходят в Telegram с повторными попытками. notified/notifyError — статус
// доставки: заявку всегда видно в админке, даже если Telegram не ответил, и можно
// переслать повторно. Так уходит «один раз дошло, второй — нет».
model Lead {
  id          String    @id @default(cuid())
  name        String?
  phone       String
  source      String? // откуда: заголовок формы / «Квиз подбора»
  message     String? // сводка квиза или доп. текст
  fileUrl     String? // /uploads/... прикреплённый файл (проект/планировка)
  fileName    String? // исходное имя файла
  consent     Boolean   @default(false)
  consentAt   DateTime?
  notified    Boolean   @default(false)
  notifyError String?
  processed   Boolean   @default(false)
  createdAt   DateTime  @default(now())
}
