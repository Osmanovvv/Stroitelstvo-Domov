DATABASE_URL="postgresql://postgres:postgres@localhost:5432/svm?schema=public"
ADMIN_USERNAME="admin"
# ВАЖНО: bcrypt-хэш содержит символы "$". В .env их нужно экранировать как "\$",
# иначе Next.js (dotenv-expand) воспримет "$2b", "$10" как переменные и испортит хэш.
# Пример: \$2b\$10\$xxxxxxxxxxxxxxxxxxxxxx
ADMIN_PASSWORD_HASH=""
AUTH_SECRET=""
