# Прод-окружение. На сервере скопируйте в .env.production и заполните реальными
# значениями. Файл .env.production в .gitignore — секреты НЕ коммитятся.

# Строка подключения к PostgreSQL (создайте БД и пользователя на сервере).
DATABASE_URL="postgresql://svm_user:СЛОЖНЫЙ_ПАРОЛЬ@localhost:5432/svm?schema=public"

# Логин администратора (/admin).
ADMIN_USERNAME="admin"

# bcrypt-хэш пароля админа. ВАЖНО: символы "$" экранируйте как "\$",
# иначе Next (dotenv-expand) воспримет "$2b"/"$10" как переменные и испортит хэш.
# Сгенерировать: node -e "console.log(require('bcryptjs').hashSync('ВАШ_ПАРОЛЬ',10))"
ADMIN_PASSWORD_HASH=""

# Секрет для подписи сессии админки (случайная строка).
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""

# Пока сайт открыт по HTTP (без SSL) — cookie сессии должна работать без флага
# Secure, иначе вход в админку не сработает. Поставьте 1 для теста по IP/HTTP.
# После подключения HTTPS — удалите эту строку (или поставьте 0).
ALLOW_INSECURE_COOKIES="1"

# Telegram-бот для доставки заявок с сайта. Без них заявки сохранятся в БД, но
# НЕ придут в Telegram (см. /admin/leads → notifyError).
#   TELEGRAM_BOT_TOKEN — токен от @BotFather (создайте отдельного БОЕВОГО бота).
#   TELEGRAM_CHAT_ID   — chat_id получателя (узнать: напишите боту, затем открыть
#     https://api.telegram.org/bot<ТОКЕН>/getUpdates и взять message.chat.id).
#   ВАЖНО: получатель должен нажать Start у бота, иначе бот не сможет ему написать.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

NODE_ENV="production"
